# Configuración de Shorts Factory — copiar a .env y ajustar

# --- General ---
# Ruta del archivo de base de datos SQLite
SF_DB_PATH=./shorts_factory.db
# Carpeta raíz donde se guardan videos y clips ({canal}/{video_id}/raw.mp4)
SF_DATA_DIR=./data
# Nivel de logging: DEBUG, INFO, WARNING, ERROR
SF_LOG_LEVEL=INFO
# Ruta opcional de archivo de log (vacío = solo consola)
SF_LOG_FILE=

# --- Etapa 1-2: Scanner y Downloader ---
# Cuántos videos recientes revisar por canal en cada escaneo
SF_SCAN_LIMIT=10
# Navegador del que tomar cookies para yt-dlp si YouTube endurece la descarga
# (chrome, firefox, edge; vacío = sin cookies)
SF_YTDLP_COOKIES_BROWSER=

# --- Etapa 3: AI Analyzer ---
# Tamaño del modelo whisper: tiny, base, small, medium, large-v3, distil-*...
# Medir en el hardware real; small = balance inicial razonable en Ryzen 9
SF_WHISPER_MODEL=small
# Hilos de CPU para whisper (0 = automático)
SF_WHISPER_CPU_THREADS=0
# Idioma forzado (es, en; vacío = detección automática)
SF_WHISPER_LANGUAGE=
# Ruta de ffmpeg (vacío/"ffmpeg" = buscar en PATH y en instalación de winget)
SF_FFMPEG_PATH=ffmpeg
# Encoder de video: auto (prueba nvenc/amf/qsv y cae a libx264), o uno explícito
SF_VIDEO_ENCODER=auto
# Duración de clips en segundos (60 = denominador común de las 4 APIs)
SF_CLIP_MIN_SECONDS=10
SF_CLIP_MAX_SECONDS=60
SF_CLIP_TARGET_SECONDS=30
SF_MAX_CLIPS_PER_VIDEO=4

# --- Etapa 4: Publisher ---
# Plataformas habilitadas, separadas por coma (vacío = no publicar)
# SF_PLATFORMS=facebook,instagram,tiktok,x
SF_PLATFORMS=
# Prioridad de cola por plataforma (mayor = primero)
SF_PRIORITY_TIKTOK=40
SF_PRIORITY_INSTAGRAM=30
SF_PRIORITY_FACEBOOK=20
SF_PRIORITY_X=10
# Reintentos máximos por publicación
SF_PUBLISH_MAX_RETRIES=3

# Meta (Facebook Reels + Instagram Reels — una sola app)
# Requiere: página de Facebook + cuenta IG empresa/creador vinculada,
# permisos instagram_basic + instagram_content_publish aprobados en App Review.
# Se opera con el PAGE ACCESS TOKEN long-lived (~60 días); App ID/Secret
# sirven para renovarlo (fb_exchange_token).
# IG User ID: GET /{page-id}?fields=instagram_business_account
SF_META_GRAPH_VERSION=v23.0
SF_META_APP_ID=
SF_META_APP_SECRET=
SF_META_PAGE_ID=
SF_META_PAGE_ACCESS_TOKEN=
# User Access Token de larga duración (~60 días, del mismo intercambio que dio
# el PAGE_ACCESS_TOKEN). Con App ID/Secret, el sistema lo usa para renovar el
# PAGE_ACCESS_TOKEN solo cuando Meta lo rechaza (no hay que repetir /me/accounts
# a mano). Se rota automáticamente y se persiste aquí (no editar a mano).
SF_META_USER_ACCESS_TOKEN=
SF_META_IG_USER_ID=

# TikTok (Content Posting API, OAuth2)
# Client Key/Secret del portal de desarrolladores; Refresh Token del flujo
# OAuth inicial. El access token dura 24 h: el adaptador lo renueva solo y
# persiste aquí el refresh token cuando TikTok lo rota (no editar a mano).
# Sin auditoría aprobada los posts quedan privados (SELF_ONLY).
SF_TIKTOK_CLIENT_KEY=
SF_TIKTOK_CLIENT_SECRET=
SF_TIKTOK_REFRESH_TOKEN=
SF_TIKTOK_ACCESS_TOKEN=
SF_TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# X (API v2, OAuth2 user context con PKCE, pago por uso)
# Client ID (y Secret si la app es confidencial); Refresh Token del flujo
# OAuth con scope offline.access. OJO: el refresh token es de UN SOLO USO —
# el adaptador lo rota y lo persiste aquí automáticamente (no editar a mano).
# El adaptador quita enlaces del texto (con enlace cuesta ~13x más por post).
SF_X_CLIENT_ID=
SF_X_CLIENT_SECRET=
SF_X_REFRESH_TOKEN=
SF_X_ACCESS_TOKEN=

# --- Etapa 5: Orquestación ---
# Minutos entre ciclos del pipeline desatendido
SF_PIPELINE_INTERVAL_MINUTES=30
